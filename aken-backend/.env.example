# =========================
# A K ENGINEERING - BACKEND
# =========================
# Copy this file to .env for local dev.
# In production (Render, Railway, etc.), set these values in Environment Variables.
#
# NEVER commit real secrets to git.

# Environment
NODE_ENV=development
PORT=5000

# =========================
# Database (Supabase PostgreSQL)
# =========================
# The API endpoint (NOT the dashboard URL): https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Service-role key (bypasses RLS). NEVER expose this to the browser.
# Found in Supabase Dashboard -> Settings -> API -> service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_jwt

# Optional: connectivity health-check timeout (ms) used by utils/db.js
# SUPABASE_CONNECT_TIMEOUT_MS=10000

# Optional: direct Postgres connection string if you run migrations/scripts
# from this machine (e.g. psql). Not used by the Express app itself.
# DATABASE_URL=postgresql://postgres:...@db.<ref>.supabase.co:5432/postgres

# =========================
# Admin session + CSRF
# =========================
# JWT secret for admin session cookie signing (required, min 32 chars).
JWT_SECRET=

# Optional: cookie domain (keep empty for host-only cookies).
# For cross-subdomain cookies you might set: .firm.in (careful).
COOKIE_DOMAIN=

# =========================
# Admin bootstrap (recommended for production)
# =========================
# Allows creating the first admin safely on a fresh database (0 users).
BOOTSTRAP_ADMIN_EMAIL=admin@aken.firm.in
BOOTSTRAP_SECRET=

# DANGEROUS: admin credential reset endpoint (keep disabled by default).
# Enable only temporarily when you must reset the admin user.
ENABLE_ADMIN_RESET=false
ADMIN_RESET_TOKEN=

# =========================
# CORS (required in production)
# =========================
# Comma-separated origins allowed to call the API with credentials (cookies).
# Production should include ONLY your frontend origin, e.g.:
# CORS_ORIGINS=https://aken.firm.in
CORS_ORIGINS=http://localhost:3000
# FRONTEND_URL= (alternative single-origin option)

# =========================
# Email (Resend)
# =========================
# This backend sends email via Resend. Create an API key at https://resend.com
RESEND_API_KEY=

# From header (supports: "Name" <email@domain>).
# Address is hard-enforced to contact@aken.firm.in regardless.
EMAIL_FROM="A K ENGINEERING" <contact@aken.firm.in>

# Admin recipients for lead alerts (comma-separated).
LEAD_ALERT_EMAILS=contact@aken.firm.in

# Optional: quotation PDF + email generation
QUOTATION_GENERATE_PDF=true

# =========================
# WhatsApp (generic webhook sender)
# =========================
# This project uses a generic webhook sender (see utils/whatsappWebhook.js).
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=
WHATSAPP_TIMEOUT_MS=8000

# Admin recipients for WhatsApp lead alerts (comma-separated E.164 or 10-digit IN numbers).
WHATSAPP_ADMIN_RECIPIENTS=918280076864

# Optional: send WhatsApp acknowledgement to client number (true/false).
WHATSAPP_SEND_CLIENT_ACK=false

# Optional: default country code used when lead phone is 10 digits.
DEFAULT_COUNTRY_CODE=91

# =========================
# Rate limiting storage
# =========================
# Default in-memory store is OK for dev.
# For production multi-instance, configure Redis (future).
